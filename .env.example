# claude2master.com — env vars (copy to .env.local, Vercel dashboard for prod)

# ── newapi (Chat 后端 + API key 申请引流) ──
NEXT_PUBLIC_NEWAPI_BASE_URL=https://newapi.lurus.cn
NEWAPI_TRIAL_TOKEN=                # 公共 trial token, 限流后端用. Phase 3 wire

# ── Lurus Platform (auth + wallet, Phase 3) ── OIDC, discovery-driven
# Issuer host must match PLATFORM_BASE_URL below. It read auth.lurus.cn — a 301
# alias whose DNS record is torn down 2026-08-19, after which discovery from a
# .env copied off this template fails outright.
OIDC_ISSUER=https://identity.lurus.cn
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PLATFORM_BASE_URL=https://identity.lurus.cn
PLATFORM_INTERNAL_KEY=

# ── KV / trial gate (Phase 3) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Vercel auto-injected ──
# VERCEL_URL — preview URL, no need to set
