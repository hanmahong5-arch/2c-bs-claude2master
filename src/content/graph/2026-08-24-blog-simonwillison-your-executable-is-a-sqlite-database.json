{
  "center": "SQLite 文件当可执行程序",
  "branches": [
    {
      "label": "核心技巧",
      "detail": "把 SQLite 数据库文件直接当 Linux 可执行二进制运行",
      "children": [
        "文件第 68 字节的 4 字节应用 ID 设为 SELF",
        "SELF 意为 Structured Executable &…"
      ]
    },
    {
      "label": "ELF 拆进表",
      "detail": "ELF 可执行格式的各组成部分被安排进多个 SQLite 表",
      "children": [
        "使用 Farid Zakaria 给出的 schema",
        "由 self-exec 解释器提取并执行"
      ]
    },
    {
      "label": "内核自动执行",
      "detail": "用 Linux 的 binfmt_misc 机制让内核识别该二进制模式",
      "children": [
        "匹配 68 字节处的 SELF 标识",
        "注册到 /proc/sys/fs/binfmt_misc/register"
      ]
    },
    {
      "label": "作者与来源",
      "detail": "Simon Willison 链接博客介绍 Farid Zakaria 的 Linux 技巧",
      "children": [
        "self-exec 解释器用 C 语言编写",
        "Farid 在 NixOS 上使用该方案"
      ]
    }
  ],
  "flow": [
