{
  "center": "自定义 provider 与本地运行时配置",
  "branches": [
    {
      "label": "自定义 provider",
      "detail": "用 models.providers 添加自定义或兼容代理 provider",
      "children": [
        "可覆盖 baseUrl、headers、模型列表",
        "compat 块仅用于已验证的自定义端点",
        "图片模型需设 input: [\"text\",\"image\"]"
      ]
    },
    {
      "label": "国内云厂商",
      "detail": "Moonshot、火山引擎、BytePlus 等接入方式",
      "children": [
        "Moonshot 需装 @openclaw/moonshot-provider",
        "火山引擎 provider: volcengine /…",
        "BytePlus 用 @openclaw/byteplus-provider"
      ]
    },
    {
      "label": "Kimi 与 Synthetic",
      "detail": "Anthropic 兼容端点接入 Kimi、Synthetic",
      "children": [
        "Kimi K3 支持 1M 上下文，$3/$15 每 MTok",
        "kimi/kimi-for-coding 为编码模型",
        "Synthetic 用 anthropic-messages API"
      ]
    },
    {
      "label": "本地运行时",
      "detail": "llama.cpp 与 llmman 本地部署方案",
      "children": [
        "llama-cpp 支持托管或已有 server",
        "llmman 默认 http://127.0.0.1:17434/v1",
        "llmman 支持本地+托管混合模型"
      ]
    }
  ],
  "flow": [
    "安装对应 provider 插件",
    "配置 models.providers 条目",
    "设置 API Key 环境变量",
    "在 agents.defaults 指定主模型",
    "重启 Gateway 生效"
  ],
