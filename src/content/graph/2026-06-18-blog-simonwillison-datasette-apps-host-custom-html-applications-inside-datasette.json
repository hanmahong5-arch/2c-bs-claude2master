    {
      "label": "数据访问",
      "detail": "通过 postMessage/MessageChannel 请求父窗口执行 SQL",
      "children": [
        "默认只读查询，白名单数据库",
        "写操作需配置 stored queries",
        "MessageChannel 页面跳转自动关闭"
      ]
    },
    {
      "label": "可见日志",
