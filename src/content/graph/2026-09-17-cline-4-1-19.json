{
  "center": "Cline v4.1.19 修复三类硬伤",
  "branches": [
    {
      "label": "压缩触发修复",
      "detail": "长任务压缩改用 provider 上报的真实 token 数，并按估算偏差缩放保留历史",
      "children": [
        "不再只靠字符数估算上下文",
        "以真实 token 计数为准"
      ]
    },
    {
      "label": "Windows 提权修复",
      "detail": "启动时设置 NoDefaultCurrentDirectoryInExePath，工作区内 rg.exe/git.exe 不再被优先执行",
      "children": [
        "可执行文件解析必须走 PATH",
        "不再优先用工作目录"
      ]
    },
    {
      "label": "静默覆盖修复",
      "detail": "apply_patch 对已存在路径的 Add File 不再静默覆盖，写操作需显式报错",
      "children": [
        "run_commands 后台子进程不再挂住管道",
        "进程管理需正确关闭输出句柄"
      ]
    }
  ],
