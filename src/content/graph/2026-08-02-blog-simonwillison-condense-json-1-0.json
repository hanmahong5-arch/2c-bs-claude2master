    {
      "label": "压缩原理",
      "detail": "扫描 JSON 中与 replacements 匹配的字符串，替换为 $r 语法",
      "children": [
        "输出形如 {\"$r\": [\"前缀\", {\"$\": \"1\"}]}",
        "可减少重复数据占用空间"
      ]
    },
    {
      "label": "可逆还原",
      "detail": "用 uncondense_json 可将压缩结果还原为原始 JSON",
      "children": [
        "condense_json 与 uncondense_json 成对使用"
      ]
    },
    {
      "label": "实际用途",
      "detail": "作者用它压缩 LLM 生成的 SQLite 日志以节省空间",
      "children": [
        "相关迭代见 PR #1586"
      ]
    }
  ],
