{
  "center": "Wrapture：统一测试与追踪",
  "branches": [
    {
      "label": "核心功能",
      "detail": "把 wrapt 的 monkeypatching 思路扩展到测试与追踪",
      "children": [
        "可包装任意函数/方法",
        "追踪访问或覆盖返回值",
        "替代 unittest.mock"
      ]
    },
    {
      "label": "配置化观测",
      "detail": "支持 OpenTelemetry，可用纯配置为现有项目加追踪",
      "children": [
        "TOML 配置 target/name/sink",
        "sink 输出 jsonlines 到 trace.jsonl"
      ]
    },
    {
      "label": "测试用法",
      "detail": "提供 binding 上下文，可 stub 返回值或改写原方法结果",
      "children": [
        "on_call.returns 返回固定值",
        "on_call.transforms_result 改写结果"
      ]
    },
    {
      "label": "AI 辅助开发",
      "detail": "Graham 首个完全由 AI 助手按方向编写的项目",
      "children": [
