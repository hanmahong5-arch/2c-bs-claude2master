    {
      "label": "测试能力",
      "detail": "可替代 unittest.mock 的单元测试用法",
      "children": [
        "记录方法调用为时间线并渲染成树",
        "分阶段行为：多次调用间改变行为"
      ]
    },
    {
      "label": "追踪能力",
      "detail": "支持活应用实时追踪与零代码配置",
      "children": [
        "用 TOML 文件配置，不改 Python 代码",
        "可导出 trace 到 OpenTelemetry"
      ]
    },
    {
      "label": "生态集成",
